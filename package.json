{
  "name": "@edgeone/vite",
  "version": "2.0.0",
  "description": "EdgeOne universal Vite adapter — supports Vite SSR, Vike, and TanStack Start",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "edgeone",
    "adapter",
    "ssr",
    "vike",
    "tanstack-start"
  ],
  "author": "EdgeOne Team",
  "license": "MIT",
  "dependencies": {
    "@universal-deploy/store": "0.1.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
